CARGO_TARPAULIN_CONFIG_FILE=.config/tarpaulin.toml
# CARGO_LLVM_COV_TARGET_DIR=""
# CARGO_LLVM_COV_BUILD_DIR=""
# CARGO_LLVM_COV_SETUP=""
# LLVM_COV=""
# LLVM_PROFDATA=""
# LLVM_COV_FLAGS=""
# LLVM_PROFDATA_FLAGS=""
# LLVM_PROFILE_FILE_NAME=""

# Cargo
CARGO_REGISTRY_TOKEN="<your-crates-io-token>"
CRATE_NAME="<your-crate-name>"
BINARY_NAME="<your-binary-name>"
RUST_VERSION="1.83"

# Docker
DOCKER_NAMESPACE="<your-dockerhub-username>"
DOCKER_IMAGE_NAME="<your-image-name>"

# Slack (optional)
SLACK_WEBHOOK="<your-slack-webhook-url>"

# Gitea (optional)
GITEA_URL="<your-gitea-instance-url>"
